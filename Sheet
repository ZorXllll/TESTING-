-- Helper function para gumawa ng auto-evolve switch para sa bawat pet
local function createAutoEvolveSwitch(folder, petName)
    local autoEvolveEnabled = false
    
    folder:AddSwitch("Auto Evolve " .. petName, function(state)
        autoEvolveEnabled = state
        
        if autoEvolveEnabled then
            task.spawn(function()
                while autoEvolveEnabled do
                    local args = {
                        [1] = "evolvePet",
                        [2] = petName
                    }

                    game:GetService("ReplicatedStorage").rEvents.petEvolveEvent:FireServer(unpack(args))
                    
                    task.wait(1.5) -- Delay bago i-fire ulit ang remote
                end
            end)
        end
    end)
end

-- Pag-generate ng bawat switch sa loob ng "Auto Evolve" folder
createAutoEvolveSwitch(autoEvolveFolder, "Core Pup")
createAutoEvolveSwitch(autoEvolveFolder, "Volt Talon")
createAutoEvolveSwitch(autoEvolveFolder, "Reactor Beast")
createAutoEvolveSwitch(autoEvolveFolder, "Plasma Ravager")
createAutoEvolveSwitch(autoEvolveFolder, "Titan Reactor")
createAutoEvolveSwitch(autoEvolveFolder, "Apex Overload")

local autoEvolveAllEnabled = false

-- Switch para i-auto evolve LAHAT ng pets sa inventory mo
autoEvolveFolder:AddSwitch("Auto Evolve All Pets", function(state)
    autoEvolveAllEnabled = state
    
    if autoEvolveAllEnabled then
        task.spawn(function()
            while autoEvolveAllEnabled do
                local player = game:GetService("Players").LocalPlayer
                local petsFolder = player and player:FindFirstChild("petsFolder")
                
                if petsFolder then
                    -- Kunin lahat ng subfolders (Unique, Common, Rare, Epic, etc.)
                    for _, subfolder in ipairs(petsFolder:GetChildren()) do
                        if subfolder:IsA("Folder") or subfolder:IsA("Configuration") then
                            -- Silipin lahat ng pets sa loob ng subfolder na yun
                            for _, pet in ipairs(subfolder:GetChildren()) do
                                if not autoEvolveAllEnabled then break end
                                
                                local args = {
                                    [1] = "evolvePet",
                                    [2] = pet.Name -- Pangalan ng pet ang pinapasa sa remote
                                }

                                game:GetService("ReplicatedStorage").rEvents.petEvolveEvent:FireServer(unpack(args))
                                task.wait(0.2) -- Kaunting delay kada pet para maiwasan ang rate limit
                            end
                        end
                    end
                end
                
                task.wait(1.5) -- Uulitin pagkatapos ng ilang segundo para i-check kung may bago kang pets
            end
        end)
    end
end)
