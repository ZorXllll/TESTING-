-- Load Elerium v2 UI Library
local library = loadstring(game:HttpGet("https://raw.githubusercontent.com/IVRzHxZ/Kyo-UI-Library/refs/heads/main/Kyo-UI-LibraryxPrivate", true))()

-- Create Window
local window = library:AddWindow("Muscle Legends", {
    main_color = Color3.fromRGB(41, 74, 122),
    min_size = Vector2.new(350, 300),
    can_resize = false,
})

-- Gumawa o gamitin ang Machines Tab
local machinesTab = window:AddTab("Farm")
machinesTab:Show()

local autoMachineAndFarmEnabled = false

-- Isang malupit at pinagsamang Switch para sa Industrial Bar Lift + Auto Rep
machinesTab:AddSwitch("Auto Industrial Bar Lift", function(state)
    autoMachineAndFarmEnabled = state
    
    if autoMachineAndFarmEnabled then
        task.spawn(function()
            -- Helper function para hanapin at gamitin ang machine seat
            local function interactWithMachine()
                local machineSeat = workspace:FindFirstChild("machinesFolder") 
                    and workspace.machinesFolder:FindFirstChild("Industrial Bar Lift") 
                    and workspace.machinesFolder["Industrial Bar Lift"]:FindFirstChild("interactSeat")
                
                if machineSeat then
                    local args = {
                        [1] = "useMachine",
                        [2] = machineSeat
                    }
                    pcall(function()
                        game:GetService("ReplicatedStorage").rEvents.machineInteractRemote:InvokeServer(unpack(args))
                    end)
                end
            end
            
            -- I-trigger agad ang pag-upo sa simula
            interactWithMachine()
            
            local timer = 0
            while autoMachineAndFarmEnabled do
                local player = game:GetService("Players").LocalPlayer
                
                -- Tuloy-tuloy na pag-fire ng rep habang nakaupo
                if player and player:FindFirstChild("muscleEvent") then
                    local args = {
                        [1] = "rep"
                    }
                    player.muscleEvent:FireServer(unpack(args))
                end
                
                -- Re-isang saksak sa machine bawat 5 segundo para hindi ma-bug o matanggal sa pagkakaupo
                timer = timer + 0.1
                if timer >= 5 then
                    timer = 0
                    interactWithMachine()
                end
                
                task.wait(0.1)
            end
        end)
    end
end)

