local autoSellFolder = crystalsTab:AddFolder("Auto Sell")

-- Helper function para gumawa ng auto-sell switch para sa bawat pet
local function createAutoSellSwitch(tab, petName)
    local autoSellEnabled = false
    
    autoSellFolder:AddSwitch("Auto Sell " .. petName, function(state)
        autoSellEnabled = state
        
        if autoSellEnabled then
            task.spawn(function()
                while autoSellEnabled do
                    local player = game:GetService("Players").LocalPlayer
                    local petsFolder = player and player:FindFirstChild("petsFolder")
                    local petTarget = nil
                    
                    if petsFolder then
                        -- Hinahanap natin ang pet sa lahat ng subfolders (Unique, Common, at iba pa)
                        for _, folder in ipairs(petsFolder:GetChildren()) do
                            if folder:IsA("Folder") or folder:IsA("Configuration") then
                                local found = folder:FindFirstChild(petName)
                                if found then
                                    petTarget = found
                                    break
                                end
                            end
                        end
                    end
                    
                    if petTarget then
                        local args = {
                            [1] = "sellPet",
                            [2] = petTarget
                        }

                        game:GetService("ReplicatedStorage").rEvents.sellPetEvent:FireServer(unpack(args))
                    end
                    
                    task.wait(1) -- Delay bago i-check ulit
                end
            end)
        end
    end)
end

