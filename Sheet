-- Switch to toggle auto-opening of the selected crystal
crystalsTab:AddSwitch("Auto Open Crystal", function(state)
    autoOpenEnabled = state
    
    if autoOpenEnabled then
        task.spawn(function()
            while autoOpenEnabled do
                local args = {
                    [1] = "openCrystal",
                    [2] = selectedCrystal
                }
                
                -- Sinubukan ko gamitin ang InvokeServer base sa binigay mo, 
                -- pero kung mag-error o hindi gumana, pwede mong palitan ng FireServer
                pcall(function()
