                for _, name in ipairs(particleNames) do
                    local effect = _Rock:FindFirstChild(name)
                    if effect then effect:Destroy() end
                end
            end
        end)

        -- 2. FAST PUNCH RENDERING LOOP (Updates every rendering frame delta)
        punchConnection = game:GetService('RunService').Heartbeat:Connect(function()
            local _Character = _LocalPlayer.Character
            if _Character and _G.punchanim then
                local _Humanoid = _Character:FindFirstChildOfClass('Humanoid')
                local _Punch = _Backpack:FindFirstChild('Punch') or _Character:FindFirstChild('Punch')
                
                if _Punch then
                    local _attackTime = _Punch:FindFirstChild('attackTime')
                    if _attackTime then _attackTime.Value = 0 end
                    if _Humanoid and _Punch.Parent ~= _Character then 
                        _Humanoid:EquipTool(_Punch) 
                    end
                    _Punch:Activate()
                end
            end
        end)

        -- 3. THE FARMING PROCESSING LOOP
        task.spawn(function()
            -- Continuous infinite thread state evaluation
            while isCombinedFarm do
                local _Character = _LocalPlayer.Character
                
                -- Task 1: Lock Mountain Rock Instance onto Character Geometry
                local _LeftHand = _Character and _Character:FindFirstChild('LeftHand')
                local _Rock = game.Workspace.machinesFolder:FindFirstChild('Muscle King Mountain') and game.Workspace.machinesFolder['Muscle King Mountain']:FindFirstChild('Rock')
