local punchConnection = nil
local isCombinedFarm = false

opfarms:AddSwitch('Fast Farming', function(state)
    isCombinedFarm = state
    _G.punchanim = state
    _G["musclekingautorock"] = state
    
    local _LocalPlayer = game.Players.LocalPlayer
    local _Backpack = _LocalPlayer:FindFirstChild('Backpack')
    
    -- Disconnect old runtime processes to cleanly restart the state machine
    if punchConnection then 
        punchConnection:Disconnect() 
        punchConnection = nil 
    end

    if state then
        -- 1. INITIALIZE ENVIRONMENT VISUALS (Runs once to optimize render pipelines)
        pcall(function()
            local _Rock = game.Workspace.machinesFolder:FindFirstChild('Muscle King Mountain'):FindFirstChild('Rock')
            if _Rock then
                _Rock.Size = Vector3.new(12, 12, 12)
                _Rock.Transparency = 1
                _Rock.CanCollide = false
                
                if _Rock:FindFirstChild('rockGui') then
                    for _, guiItem in ipairs(_Rock.rockGui:GetChildren()) do
                        guiItem.Visible = false
                    end
                end
                
                local particleNames = {'rockEmitter', 'hoopParticle', 'lavaParticle'}
                for _, name in ipairs(particleNames) do
                    local effect = _Rock:FindFirstChild(name)
                    if effect then effect:Destroy() end
                end
            end
        end)

        -- 2. FAST PUNCH RENDERING LOOP (Updates every rendering frame delta)
        punchConnection = game:GetService('RunService').Heartbeat:Connect(function()
            local _Character = _LocalPlayer.Character
            if _Character and _G.punchanim then
                local _Humanoid = _Character:FindFirstChildOfClass('Humanoid')
                local _Punch = _Backpack:FindFirstChild('Punch') or _Character:FindFirstChild('Punch')
                
                if _Punch then
                    local _attackTime = _Punch:FindFirstChild('attackTime')
                    if _attackTime then _attackTime.Value = 0 end
                    if _Humanoid and _Punch.Parent ~= _Character then 
                        _Humanoid:EquipTool(_Punch) 
                    end
                    _Punch:Activate()
                end
            end
        end)

        -- 3. THE FARMING PROCESSING LOOP
        task.spawn(function()
            -- Continuous infinite thread state evaluation
            while isCombinedFarm do
                local _Character = _LocalPlayer.Character
                
                -- Task 1: Lock Mountain Rock Instance onto Character Geometry
                local _LeftHand = _Character and _Character:FindFirstChild('LeftHand')
                local _Rock = game.Workspace.machinesFolder:FindFirstChild('Muscle King Mountain') and game.Workspace.machinesFolder['Muscle King Mountain']:FindFirstChild('Rock')
                if _Rock and _LeftHand then
                    _Rock.CFrame = _LeftHand.CFrame
                end
                
                -- Task 2: Maintain Pushup Tool Assembly State Hierarchy 
                local _Pushups = _Backpack and _Backpack:FindFirstChild('Pushups')
                if _Pushups and _Character and _Character:FindFirstChildOfClass('Humanoid') then
                    _Character.Humanoid:EquipTool(_Pushups)
                end
                
                -- Task 3: Package Datagram Array and Execute Network Request Upstream
                if _LocalPlayer:FindFirstChild('muscleEvent') then
                    _LocalPlayer.muscleEvent:FireServer(unpack({'rep'}))
                end
                
                -- Task Yield: Safely hands threading priority back to engine memory pipeline
                task.wait(0.01)
            end
        end)

    else
        -- 4. CLEAN RESET EXECUTABLE STACK (When state evaluation defaults to false)
        
        -- Restore tool properties to original profile boundaries
        local _Punch = _Backpack:FindFirstChild('Punch') or (_LocalPlayer.Character and _LocalPlayer.Character:FindFirstChild('Punch'))
        if _Punch and _Punch:FindFirstChild('attackTime') then 
            _Punch.attackTime.Value = 0.35 
        end
        
        -- Safely re-parent isolated tool models back to local collection inventory
        if _LocalPlayer.Character then
            local _Tool = _LocalPlayer.Character:FindFirstChildOfClass('Tool')
            if _Tool and _Tool.Name == 'Pushups' then
                _Tool.Parent = _Backpack
            end
        end
        
        -- Revert physical game workspace models back to client map positions
        pcall(function()
            local _Rock = game.Workspace.machinesFolder:FindFirstChild('Muscle King Mountain'):FindFirstChild('Rock')
            if _Rock then
                if _Rock:FindFirstChild('rockGui') then
                    for _, guiItem in ipairs(_Rock.rockGui:GetChildren()) do
                        guiItem.Visible = true
                    end
                end
                _Rock.CanCollide = true
                _Rock.Transparency = 0
                _Rock.Size = Vector3.new(141.97381591796875, 123.69998931884766, 149.70497131347656)
                if _Rock:FindFirstChild('originalPosition') then 
                    _Rock.CFrame = CFrame.new(_Rock.originalPosition.Value) 
                end
            end
        end)
    end
end):Set(false)

